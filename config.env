KERNEL_SOURCE=https://android.googlesource.com/kernel/common
KERNEL_SOURCE_BRANCH=android12-5.10.226_r00
KERNEL_CONFIG=gki_defconfig
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64
KERNEL_NAME=

CLANG_BRANCH=master-kernel-build-2021
CLANG_VERSION=r416183b
USE_LLVM=true
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false
EXTRA_CMDS:
CUSTOM_CMDS:

# SukiSU-Ultra's main branch is the modular v4 tree and supports KPM.
KSU_VARIANT=none
KSU_REF=main
KSU_HOOK_MODE=auto
ENABLE_KPM=false

# Droidspace
ENABLE_DROIDSPACES=true
SYSVIPC_KABI_PATCH=001.GKI-below-6.12-fix_sysvipc_kabi_6_7_8.patch
# Use stock config for /proc/config.gz to bypass the VINTEF compatibility check.
ENABLE_STOCKCONFIG=true
ENABLE_CUSTOM_PATCHES=true

# SUSFS_BRANCH=auto resolves 6.6 to gki-android15-6.6.
ENABLE_SUSFS=false
SUSFS_BRANCH=auto

# path_umount is already upstream in 6.6; leaving this on is harmless (the
# step detects it and skips) but there is no reason to enable it.
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false

ADD_OVERLAYFS_CONFIG=false
ADD_KPROBES_CONFIG=false
DISABLE_LTO=false
DISABLE_CC_WERROR=false
EXTRA_DEFCONFIG=

NEED_DTBO=false
BUILD_BOOT_IMG=true
SOURCE_BOOT_IMAGE=https://github.com/5kind/payload-dumper/releases/download/boot-images/xaga-ota_full-OS2.0.12.0.ULOCNXM-user-14.0-5c4e2efff9-boot.img

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
